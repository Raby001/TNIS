        },
        "header": [],
        "description": "Ascending history, page 2"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const createdId = pm.collectionVariables.get('fixtureId');",
              "if (!createdId) throw new Error('Create the fixture successfully before running this request');",
              "pm.variables.set('fixtureId', createdId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Expected ordered fixture event and page metadata', () => {",
              "  const {data,meta} = pm.response.json();",
              "  pm.expect(meta).to.deep.equal({page:2,limit:1,total:3,totalPages:3});",
              "  pm.expect(data).to.have.lengthOf(1);",
              "  pm.expect(data[0].action).to.equal('UPDATE');",
              "});"
            ]
          }
        }
      ],
      "response": []
    }
