{
  "info": {
    "name": "TNIS inventory audit",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against an approved test environment after the SQL migration is applied. Set baseUrl (including /api/v2), adminUsername, and local-only adminToken/viewerToken variables from POST /auth/login. Supply an existing siteId, a poleTypeId, lifecycleStatusId and conditionId using sites and reference-data endpoints. Requests create, update and delete one new pole, leaving its audit entries. The failed update tests validation. Backend/test/audit-rollback.sql separately exercises an actual database rollback. Saved response examples are illustrative."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v2",
      "type": "string"
    },
    {
      "key": "adminUsername",
      "value": "",
      "type": "string"
    },
    {
      "key": "poleTypeId",
      "value": "",
      "type": "string"
    },
    {
      "key": "siteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "lifecycleStatusId",
      "value": "",
      "type": "string"
    },
    {
      "key": "conditionId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create a pole asset for this run",
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/poles",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "poles"
          ]
        },
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "description": "Create a pole asset for this run",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assetTypeId\": \"{{poleTypeId}}\",\n  \"lifecycleStatusId\": \"{{lifecycleStatusId}}\",\n  \"conditionId\": \"{{conditionId}}\",\n  \"siteId\": \"{{siteId}}\",\n  \"name\": \"{{fixtureName}}\",\n  \"heightM\": 10,\n  \"geometry\": {\n    \"type\": \"Point\",\n    \"coordinates\": [\n      104.9173,\n      11.5624\n    ]\n  }\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "for (const key of ['fixtureId','auditId','userId','firstPageId']) pm.collectionVariables.unset(key);",
              "pm.collectionVariables.set('fixtureName', 'Audit fixture ' + pm.variables.replaceIn('{{$guid}}'));",
              "pm.collectionVariables.set('from', new Date(Date.now()-3600000).toISOString());",
              "pm.collectionVariables.set('to', new Date(Date.now()+3600000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Store only the pole created for this run', () => {",
              "  const pole = pm.response.json();",
              "  pm.expect(pole.asset.name).to.equal(pm.collectionVariables.get('fixtureName'));",
              "  pm.expect(pole.assetId).to.match(/^[0-9a-f-]{36}$/i);",
              "  pm.collectionVariables.set('fixtureId', pole.assetId);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "Verify committed asset CREATE and its actor",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/audit-logs?entityType=assets&entityId={{fixtureId}}&action=CREATE",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "audit-logs"
          ],
          "query": [
            {
              "key": "entityType",
              "value": "assets"
            },
            {
              "key": "entityId",
              "value": "{{fixtureId}}"
            },
            {
              "key": "action",
              "value": "CREATE"
            }
          ]
        },
        "header": [],
        "description": "Verify committed asset CREATE and its actor"
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const createdId = pm.collectionVariables.get('fixtureId');",
              "if (!createdId) throw new Error('Create the fixture successfully before running this request');",
              "pm.variables.set('fixtureId', createdId);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Exactly one CREATE belongs to the expected admin', () => {",
              "  const {data,meta} = pm.response.json();",
              "  pm.expect(meta.total).to.equal(1);",
              "  const row = data[0];",
              "  pm.expect(row.entityId).to.equal(pm.collectionVariables.get('fixtureId'));",
              "  pm.expect(row.username).to.equal(pm.variables.get('adminUsername'));",
              "  pm.expect(row.userId).to.be.a('string');",
              "  pm.expect(row.oldValues).to.equal(null);",
              "  pm.expect(row.newValues.name).to.equal(pm.collectionVariables.get('fixtureName'));",
              "  pm.collectionVariables.set('userId', row.userId);",
              "  pm.collectionVariables.set('auditId', row.id);",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
